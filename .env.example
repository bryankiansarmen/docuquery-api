# OpenRouter API Key
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Chat model used to generate answers (default: deepseek/deepseek-chat)
OPENROUTER_CHAT_MODEL=deepseek/deepseek-chat
# Embedding model used for document/query vectors (default: baai/bge-m3)
OPENROUTER_EMBEDDING_MODEL=baai/bge-m3
APP_API_KEY=your_app_api_key_here

# Optional: per-tenant API keys as a JSON object {"tenant_id": "api_key", ...}.
# When set, the tenant is derived from the X-API-Key and self-declared
# X-Tenant-Id headers are rejected. Leave empty to use the shared APP_API_KEY
# with header-based (self-declared) tenancy.
APP_API_KEYS=

# Maximum allowed PDF upload size in bytes (default: 25MB)
MAX_UPLOAD_BYTES=26214400

REDIS_HOST=your_redis_host_here
REDIS_PORT=your_redis_port_here
REDIS_PASSWORD=your_redis_password_here

# Set to false to disable per-key rate limiting (default: true)
RATE_LIMIT_ENABLED=true

# Worker tuning (defaults shown)
# WORKER_MAX_ATTEMPTS=3
# WORKER_CONCURRENCY=2

# Chroma Cloud connection details
CHROMA_HOST=api.trychroma.com
CHROMA_PORT=443
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_chroma_tenant_here
CHROMA_DATABASE=docuquery

# MongoDB connection
# Set MONGO_URL explicitly to override (e.g. for a standalone/App Services URI).
# Otherwise the URI is composed from MONGO_HOST/PORT + MONGO_USERNAME/PASSWORD.
MONGO_URL=
MONGO_HOST=mongodb
MONGO_PORT=27017
# Use mongodb+srv (true) for Atlas-style hosts (serverless/cluster DNS)
MONGO_SRV=false
MONGO_USERNAME=
MONGO_PASSWORD=
# Chat history retention in days (TTL index; 0 disables expiry)
CHAT_HISTORY_TTL_DAYS=90
