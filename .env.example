# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
APP_API_KEY=your_app_api_key_here
REDIS_HOST=your_redis_host_here
REDIS_PORT=your_redis_port_here
REDIS_PASSWORD=your_redis_password_here

# Set to false to disable per-key rate limiting (default: true)
RATE_LIMIT_ENABLED=true

# Chroma Cloud connection details
CHROMA_HOST=api.trychroma.com
CHROMA_PORT=443
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_chroma_tenant_here
CHROMA_DATABASE=docuquery

# MongoDB connection
# Set MONGO_URL explicitly to override (e.g. for a standalone/App Services URI).
# Otherwise the URI is composed from MONGO_HOST/PORT + MONGO_USERNAME/PASSWORD.
MONGO_URL=
MONGO_HOST=mongodb
MONGO_PORT=27017
# Use mongodb+srv (true) for Atlas-style hosts (serverless/cluster DNS)
MONGO_SRV=false
MONGO_USERNAME=
MONGO_PASSWORD=